&share
 wrf_core                     = 'ARW',
 max_dom                      = 5,
 start_date                   = '2015-09-24_00:00:00','2015-09-24_00:00:00','2015-09-24_00:00:00','2015-09-24_00:00:00','2015-09-24_00:00:00',
 end_date                     = '2015-09-27_06:00:00','2015-09-27_06:00:00','2015-09-27_06:00:00','2015-09-27_06:00:00','2015-09-27_06:00:00',
 interval_seconds             = 10800,
 io_form_geogrid              = 2,
/


&geogrid
 parent_id                    = 1,1,2,3,4,
 parent_grid_ratio            = 1,3,3,3,3,
 i_parent_start               = 1,55,55,55,55,
 j_parent_start               = 1,55,55,55,55,
 e_we                         = 163,163,163,163,163,
 e_sn                         = 163,163,163,163,163,
 dx                           = 9000,
 dy                           = 9000,
 map_proj                     = 'lambert',
 ref_lat                      = 38.0142,
 ref_lon                      = 100.3421,
 truelat1                     = 30,
 truelat2                     = 60,
 stand_lon                    = 100.3421,
 geog_data_path               = '/path/to/wps_geog/',
 geog_data_res                = 'topo_3s_hma+landuse_3s_hma+usgs_lakes+default','topo_3s_hma+landuse_3s_hma+usgs_lakes+default','topo_3s_hma+landuse_3s_hma+usgs_lakes+default','topo_3s_hma+landuse_3s_hma+usgs_lakes+default','topo_3s_hma+landuse_3s_hma+usgs_lakes+default',

/
&ungrib
 out_format                   = 'WPS',
 prefix                       = '/path/to/wrf/run/out_ungrib_file/',
/

&metgrid
 fg_name                      = '/path/to/wrf/run/out_ungrib_file/',
 io_form_metgrid              = 2, 
 constants_name               = './TAVGSFC',
 opt_output_from_metgrid_path = '/path/to/wrf/run/out_metgrid_file/',
/
